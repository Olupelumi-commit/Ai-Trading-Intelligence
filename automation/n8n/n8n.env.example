# n8n deployment settings for PAWO automation (Phase 8). Verified against n8n 2.39.7.
# Secrets belong in a secret manager or the n8n credential store, never in a committed file.

# --- identity and encryption -------------------------------------------------------------------
# Required. Encrypts the credential store; losing it invalidates every stored credential.
N8N_ENCRYPTION_KEY=__from_secret_manager__

# --- security ----------------------------------------------------------------------------------
# Keep environment access blocked (the 2.x default): PAWO workflows read no process environment,
# and enabling it would expose every variable, including this encryption key, to workflow editors.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# Bound the webhook payload PAWO events need (MiB).
N8N_PAYLOAD_SIZE_MAX=1
# Nodes PAWO automation never uses; excluding them removes the capability entirely.
NODES_EXCLUDE=["n8n-nodes-base.executeCommand","n8n-nodes-base.readWriteFile","n8n-nodes-base.ssh"]
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_SECURE_COOKIE=true
N8N_HIRING_BANNER_ENABLED=false

# --- execution data retention ------------------------------------------------------------------
# Execution data can hold analysis payloads: keep failures long enough to recover, prune the rest.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_TIMEOUT=600
EXECUTIONS_TIMEOUT_MAX=900

# --- addressing --------------------------------------------------------------------------------
# The public base URL of this n8n instance; PAWO webhooks are delivered under it.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
GENERIC_TIMEZONE=UTC

# --- state -------------------------------------------------------------------------------------
# n8n keeps its own operational state; PAWO remains the system of record for setups, analyses,
# research, strategy state, risk state and every idempotency or delivery record.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-db
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=__from_secret_manager__
